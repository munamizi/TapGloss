<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsLookup.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TapGloss</AssemblyName>
    <AssemblyTitle>TapGloss</AssemblyTitle>
    <Product>TapGloss</Product>
    <Version>0.5.7</Version>
    <Description>TapGloss</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="WindowsLookup.App.TrayIcon.ico" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <ProjectReference Include="../WindowsLookup.Core/WindowsLookup.Core.csproj" />
  </ItemGroup>
  <!-- 非 MSIX 发布会遗漏编译后的 XAML 和资源索引，需与可执行文件一起复制。 -->
  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)App.xbf;$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- 发布包内必须包含唯一音色 Amy 的模型和运行环境。 -->
  <Target Name="CheckPiperVoiceBundle" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(PiperVoiceBundle)' == '' Or !Exists('$(PiperVoiceBundle)\en_US-amy-medium.onnx') Or !Exists('$(PiperVoiceBundle)\en_US-amy-medium.onnx.json') Or !Exists('$(PiperVoiceBundle)\python\python.exe') Or !Exists('$(PiperVoiceBundle)\packages\piper\__init__.py')"
           Text="请通过 PiperVoiceBundle 指定完整的 Amy 离线语音目录。" />
  </Target>
  <Target Name="CopyPiperVoiceToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PiperVoiceFiles Include="$(PiperVoiceBundle)\**\*"
                       Exclude="$(PiperVoiceBundle)\**\__pycache__\**\*;$(PiperVoiceBundle)\packages\bin\**\*;$(PiperVoiceBundle)\python\include\**\*;$(PiperVoiceBundle)\python\libs\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PiperVoiceFiles)"
          DestinationFiles="@(_PiperVoiceFiles->'$(PublishDir)voice\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\tools\WindowsLookup.Piper\worker.py"
          DestinationFolder="$(PublishDir)voice"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
