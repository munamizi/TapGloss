<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsLookup.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TapGloss</AssemblyName>
    <AssemblyTitle>TapGloss</AssemblyTitle>
    <Product>TapGloss</Product>
    <Version>0.5.16</Version>
    <Description>TapGloss</Description>
    <AmyVoiceBundle Condition="'$(AmyVoiceBundle)' == ''">$(PiperVoiceBundle)</AmyVoiceBundle>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="WindowsLookup.App.TrayIcon.ico" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <ProjectReference Include="../WindowsLookup.Core/WindowsLookup.Core.csproj" />
  </ItemGroup>
  <!-- 非 MSIX 发布会遗漏编译后的 XAML 和资源索引，需与可执行文件一起复制。 -->
  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)App.xbf;$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- 校验模型、词表和发音数据，再由真实发布程序加载并合成。 -->
  <Target Name="CheckAmyVoiceBundle" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(AmyVoiceBundle)' == ''" Text="请通过 AmyVoiceBundle 指定完整的 Amy 离线模型目录。" />
    <ItemGroup>
      <_AmyRequired Include="en_US-amy-medium.onnx;tokens.txt;espeak-ng-data\phontab;espeak-ng-data\phonindex;espeak-ng-data\phondata;espeak-ng-data\intonations" />
    </ItemGroup>
    <Error Condition="!Exists('$(AmyVoiceBundle)\%(_AmyRequired.Identity)')"
           Text="Amy 语音包缺少文件：%(_AmyRequired.Identity)" />
  </Target>
  <Target Name="CopyAmyVoiceToPublish" AfterTargets="Publish">
    <Error Condition="Exists('$(PublishDir)voice\python') Or Exists('$(PublishDir)voice\packages') Or Exists('$(PublishDir)voice\worker.py')"
           Text="发布目录含旧语音运行时，请用新的发布目录生成 Amy 静态数据包。" />
    <ItemGroup>
      <_AmyModelFiles Include="$(AmyVoiceBundle)\en_US-amy-medium.onnx;$(AmyVoiceBundle)\tokens.txt" />
      <_AmyModelFiles Include="$(AmyVoiceBundle)\MODEL_CARD" Condition="Exists('$(AmyVoiceBundle)\MODEL_CARD')" />
      <_AmyEspeakFiles Include="$(AmyVoiceBundle)\espeak-ng-data\**\*"
                       Exclude="$(AmyVoiceBundle)\espeak-ng-data\**\*.exe;$(AmyVoiceBundle)\espeak-ng-data\**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AmyModelFiles)" DestinationFolder="$(PublishDir)voice" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AmyEspeakFiles)"
          DestinationFiles="@(_AmyEspeakFiles->'$(PublishDir)voice\espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="VerifyPublishedAmyVoice" AfterTargets="CopyAmyVoiceToPublish" Condition="'$(SkipVoiceSelfTest)' != 'true'">
    <Exec Command="&quot;.\$(AssemblyName).exe&quot; --speech-selftest" WorkingDirectory="$(PublishDir)" />
  </Target>
</Project>
